<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_bg">

    <!-- ============================================================== -->
    <!-- MAIN APP SHELL (LEFT RAIL + SCREEN HOST)                       -->
    <!-- ============================================================== -->
    <LinearLayout
        android:id="@+id/mainShellContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@color/obsidian_bg">

        <!-- SLIM OBSIDIAN LEFT RAIL -->
        <LinearLayout
            android:id="@+id/leftRail"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:background="@color/rail_bg"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JewFlix"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="0.55" />

            <!-- 1. Home -->
            <FrameLayout
                android:id="@+id/navRailHome"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/bg_rail_icon">

                <View
                    android:id="@+id/navIndicatorHome"
                    android:layout_width="3dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_active_indicator" />

                <ImageView
                    android:id="@+id/navIconHome"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_home"
                    android:tint="#FFFFFF"
                    android:contentDescription="Home" />
            </FrameLayout>

            <!-- 2. Search -->
            <FrameLayout
                android:id="@+id/navRailSearch"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/bg_rail_icon">

                <View
                    android:id="@+id/navIndicatorSearch"
                    android:layout_width="3dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_active_indicator"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/navIconSearch"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_search"
                    android:tint="#6E7687"
                    android:contentDescription="Search" />
            </FrameLayout>

            <!-- 3. Categories -->
            <FrameLayout
                android:id="@+id/navRailCategories"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/bg_rail_icon">

                <View
                    android:id="@+id/navIndicatorCategories"
                    android:layout_width="3dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_active_indicator"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/navIconCategories"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_categories"
                    android:tint="#6E7687"
                    android:contentDescription="Categories" />
            </FrameLayout>

            <!-- 4. Library -->
            <FrameLayout
                android:id="@+id/navRailLibrary"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/bg_rail_icon">

                <View
                    android:id="@+id/navIndicatorLibrary"
                    android:layout_width="3dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_active_indicator"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/navIconLibrary"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_library"
                    android:tint="#6E7687"
                    android:contentDescription="Library" />
            </FrameLayout>

            <!-- 5. Settings -->
            <FrameLayout
                android:id="@+id/navRailSettings"
                android:layout_width="46dp"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/bg_rail_icon">

                <View
                    android:id="@+id/navIndicatorSettings"
                    android:layout_width="3dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_active_indicator"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/navIconSettings"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_settings"
                    android:tint="#6E7687"
                    android:contentDescription="Settings" />
            </FrameLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Engine Status Pill Badge -->
            <TextView
                android:id="@+id/tvEngineRailBadge"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="J"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill" />
        </LinearLayout>

        <!-- Vertical hairline divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#12151E" />

        <!-- RIGHT SCREEN HOST -->
        <FrameLayout
            android:id="@+id/screenHost"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- ========================================================== -->
            <!-- TAB 0: HOME SCREEN (HERO SPOTLIGHT + SHELVES)              -->
            <!-- ========================================================== -->
            <ScrollView
                android:id="@+id/screenHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="28dp">

                    <!-- HERO SPOTLIGHT BLOCK -->
                    <FrameLayout
                        android:id="@+id/homeHeroContainer"
                        android:layout_width="match_parent"
                        android:layout_height="268dp">

                        <ImageView
                            android:id="@+id/homeHeroBackdrop"
                            android:layout_width="640dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="end|top"
                            android:scaleType="centerCrop"
                            android:contentDescription="Hero Backdrop" />

                        <View
                            android:layout_width="540dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="start"
                            android:background="@drawable/bg_hero_scrim_left" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_hero_scrim_bottom" />

                        <LinearLayout
                            android:layout_width="490dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:orientation="vertical"
                            android:paddingStart="28dp"
                            android:paddingBottom="22dp">

                            <!-- Badges Row -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <TextView
                                    android:id="@+id/homeHeroRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_gold"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="2.5dp"
                                    android:paddingBottom="2.5dp"
                                    android:text="★ 8.6"
                                    android:textColor="#FBBF24"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/homeHeroYear"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:background="@drawable/bg_pill"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="2.5dp"
                                    android:paddingBottom="2.5dp"
                                    android:text="2024"
                                    android:textColor="#E2E8F0"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/homeHeroQuality"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:background="@drawable/bg_pill"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="2.5dp"
                                    android:paddingBottom="2.5dp"
                                    android:text="4K HDR"
                                    android:textColor="#10B981"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/homeHeroGenres"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text="Featured Spotlight"
                                    android:textColor="#9CA3AF"
                                    android:textSize="10.5sp"
                                    android:maxLines="1"
                                    android:ellipsize="end" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/homeHeroTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="FEATURED CINEMA"
                                android:textColor="#FFFFFF"
                                android:textSize="27sp"
                                android:textStyle="bold"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/homeHeroDesc"
                                android:layout_width="410dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Loading spotlight from Cinemeta catalog..."
                                android:textColor="#CBD5E1"
                                android:textSize="11.5sp"
                                android:lineSpacingExtra="2dp"
                                android:maxLines="2"
                                android:ellipsize="end" />

                            <!-- CTA Buttons -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="14dp">

                                <TextView
                                    android:id="@+id/btnHomeWatch"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:gravity="center"
                                    android:paddingStart="18dp"
                                    android:paddingEnd="18dp"
                                    android:background="@drawable/selector_pill_primary"
                                    android:text="▶  Watch Now"
                                    android:textColor="#050507"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold"
                                    android:focusable="true"
                                    android:clickable="true" />

                                <TextView
                                    android:id="@+id/btnHomeSources"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:layout_marginStart="10dp"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:background="@drawable/selector_pill_secondary"
                                    android:text="ⓘ  Sources &amp; Info"
                                    android:textColor="#F8FAFC"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold"
                                    android:focusable="true"
                                    android:clickable="true" />

                                <TextView
                                    android:id="@+id/btnHomeLibrary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="34dp"
                                    android:layout_marginStart="10dp"
                                    android:gravity="center"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:background="@drawable/selector_pill_secondary"
                                    android:text="+ Library"
                                    android:textColor="#F8FAFC"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold"
                                    android:focusable="true"
                                    android:clickable="true" />
                            </LinearLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <!-- SHELF 0: CONTINUE WATCHING (VISIBLE WHEN NON-EMPTY) -->
                    <LinearLayout
                        android:id="@+id/homeContinueSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="14dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="28dp"
                            android:paddingBottom="8dp"
                            android:text="Continue Watching"
                            android:textColor="#F8FAFC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvHomeContinue"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:paddingStart="28dp"
                            android:paddingEnd="28dp"
                            android:clipToPadding="false" />
                    </LinearLayout>

                    <!-- SHELF 1: TRENDING MOVIES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="28dp"
                            android:paddingBottom="8dp"
                            android:text="Trending Movies"
                            android:textColor="#F8FAFC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvHomeMovies"
                            android:layout_width="match_parent"
                            android:layout_height="204dp"
                            android:paddingStart="28dp"
                            android:paddingEnd="28dp"
                            android:clipToPadding="false" />
                    </LinearLayout>

                    <!-- SHELF 2: POPULAR TV SERIES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="28dp"
                            android:paddingBottom="8dp"
                            android:text="Popular TV Series"
                            android:textColor="#F8FAFC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvHomeSeries"
                            android:layout_width="match_parent"
                            android:layout_height="204dp"
                            android:paddingStart="28dp"
                            android:paddingEnd="28dp"
                            android:clipToPadding="false" />
                    </LinearLayout>

                    <!-- SHELF 3: ARABIC DUB & CARTOON CLASSICS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="28dp"
                            android:paddingBottom="8dp"
                            android:text="Arabic Dub &amp; Cartoon Classics"
                            android:textColor="#F8FAFC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvHomeCartoons"
                            android:layout_width="match_parent"
                            android:layout_height="204dp"
                            android:paddingStart="28dp"
                            android:paddingEnd="28dp"
                            android:clipToPadding="false" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- TAB 1: SEARCH SCREEN VIEWSTUB -->
            <ViewStub
                android:id="@+id/stubSearch"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/layout_screen_search" />

            <!-- TAB 2: CATEGORIES VIEWSTUB -->
            <ViewStub
                android:id="@+id/stubCategories"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/layout_screen_categories" />

            <!-- TAB 3: LIBRARY VIEWSTUB -->
            <ViewStub
                android:id="@+id/stubLibrary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/layout_screen_library" />

            <!-- TAB 4: SETTINGS VIEWSTUB -->
            <ViewStub
                android:id="@+id/stubSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout="@layout/layout_screen_settings" />

        </FrameLayout>
    </LinearLayout>

    <!-- MOVIE DETAIL OVERLAY VIEWSTUB -->
    <ViewStub
        android:id="@+id/stubDetailMovie"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_detail_movie" />

    <!-- SERIES DETAIL OVERLAY VIEWSTUB -->
    <ViewStub
        android:id="@+id/stubDetailSeries"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_detail_series" />

</FrameLayout>
