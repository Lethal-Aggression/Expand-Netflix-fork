<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="28dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Engine &amp; Streaming Settings"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="JewEngine v2.0 • LRU Bounded Rolling Storage • 4K Responsive Buffer"
            android:textColor="#6E7687"
            android:textSize="11sp" />

        <!-- Card 1: Rolling Disk Cache & Prewarm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_surface_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROLLING BIT-TORRENT CACHE &amp; TV STORAGE GUARD"
                android:textColor="#10B981"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvSettingsCacheTelemetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Active Engine Cache: Checking..."
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Maximum Rolling Cache Footprint"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/btnCache160"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/selector_chip_pill"
                    android:text="160 MB (Safe)"
                    android:textColor="@color/color_chip_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/btnCache240"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/selector_chip_pill"
                    android:text="240 MB (Balanced)"
                    android:textColor="@color/color_chip_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/btnCache360"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/selector_chip_pill"
                    android:text="360 MB (High 4K)"
                    android:textColor="@color/color_chip_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/btnCacheWipeNow"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/selector_pill_secondary"
                    android:text="Wipe Cache Now"
                    android:textColor="#FCA5A5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Instant Pre-Warm Top Torrent on Detail Screen"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnTogglePrewarm"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/selector_chip_pill"
                    android:text="Enabled"
                    android:textColor="@color/color_chip_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card 2: Real-Debrid / Addon URL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_surface_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STREMIO ADDONS &amp; DEBRID ACCELERATION"
                android:textColor="#60A5FA"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvSettingsAddonStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Active Addon: https://torrentio.strem.fun"
                android:textColor="#F8FAFC"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/btnSetRealDebrid"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/selector_pill_secondary"
                    android:text="Set Real-Debrid Key"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/btnSetCustomAddon"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/selector_pill_secondary"
                    android:text="Set Custom Addon URL"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />

                <TextView
                    android:id="@+id/btnResetAddon"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/selector_pill_secondary"
                    android:text="Reset Default"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:focusable="true"
                    android:clickable="true" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>