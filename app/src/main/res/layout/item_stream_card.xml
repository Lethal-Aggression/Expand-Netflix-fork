<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="224dp"
    android:layout_height="126dp"
    android:layout_marginEnd="12dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/selector_stream_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Quality Pill + Addon Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/streamQualityPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="4K HDR10"
            android:textColor="#050507"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/streamAddonTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TORRENTIO"
            android:textColor="#6E7687"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Release Name -->
    <TextView
        android:id="@+id/streamReleaseTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#F8FAFC"
        android:textSize="11sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Codecs -->
    <TextView
        android:id="@+id/streamCodecTags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#8E96A4"
        android:textSize="9.5sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Row: Peers/Status + Size -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/streamPeersStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● 412 peers"
            android:textColor="#10B981"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/streamSizeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18.4 GB"
            android:textColor="#F8FAFC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
