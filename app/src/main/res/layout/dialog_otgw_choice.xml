<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="660dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/selector_card" android:padding="28dp">
  <TextView android:id="@+id/dialogTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Over the Garden Wall (خلف حائط الحديقة)" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
  <TextView android:id="@+id/dialogSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="24dp" android:text="اختر وضع المشاهدة المطلوب / Select Playback Mode" android:textColor="#AAAAAA" android:textSize="13sp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
    <LinearLayout android:id="@+id/btnOptionMovie" android:layout_width="0dp" android:layout_height="210dp" android:layout_weight="1" android:layout_marginEnd="12dp" android:background="@drawable/selector_card" android:orientation="vertical" android:padding="20dp" android:focusable="true" android:clickable="true" android:nextFocusRight="@+id/btnOptionSeries">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎬" android:textSize="28sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="الفيلم الكامل (78 دقيقة)" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_pill" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="Cartoon Network Arabic" android:textColor="#FFCC00" android:textSize="11sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="نسخة الفيلم السينمائية المستمرة كاملة بدون فواصل بين الحلقات" android:textColor="#888888" android:textSize="12sp" android:lineSpacingExtra="2dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/btnOptionSeries" android:layout_width="0dp" android:layout_height="210dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/selector_card" android:orientation="vertical" android:padding="20dp" android:focusable="true" android:clickable="true" android:nextFocusLeft="@+id/btnOptionMovie">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📺" android:textSize="28sp" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="تصفح الحلقات (Episodes)" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_pill" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="1080p BluRay • 10 Episodes" android:textColor="#00DDFF" android:textSize="11sp" android:textStyle="bold" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="مشاهدة المسلسل حلقة بحلقة بالدقة العالية مع قائمة الحلقات" android:textColor="#888888" android:textSize="12sp" android:lineSpacingExtra="2dp" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>