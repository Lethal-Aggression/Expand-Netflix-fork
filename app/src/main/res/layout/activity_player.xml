<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit" />

    <!-- Top & Bottom Stealth HUD Vignettes -->
    <View
        android:id="@+id/vignetteTop"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="top"
        android:rotation="180"
        android:background="@drawable/bg_hero_scrim_bottom" />

    <View
        android:id="@+id/vignetteBottom"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_hero_scrim_bottom" />

    <!-- TOP HUD METADATA + LIVE BITRATE/SPEED PILL -->
    <RelativeLayout
        android:id="@+id/hudTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JewFlix Player"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxWidth="540dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvPlayerStreamBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#B30A0C12"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2.5dp"
                android:paddingBottom="2.5dp"
                android:text="Initializing Stream"
                android:textColor="#10B981"
                android:textSize="10.5sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="JewFlix"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />
    </RelativeLayout>

    <!-- Buffering Telemetry Overlay -->
    <LinearLayout
        android:id="@+id/layoutBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/bufferingSpinner"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tvBufferingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#F8FAFC"
            android:textSize="12.5sp"
            android:fontFamily="monospace"
            android:text="Buffering stream..." />
    </LinearLayout>

    <!-- Quick Seek OSD Pill -->
    <TextView
        android:id="@+id/tvSeekOsd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#E60A0C12"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- BOTTOM SCRUBBER + TV BUTTONS HUD -->
    <LinearLayout
        android:id="@+id/hudControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:id="@+id/scrubberRow"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvTimeCurrent"
                android:layout_width="wrap_content"
                android:minWidth="54dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#F8FAFC"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="end" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:max="1000"
                android:progress="0"
                android:focusable="true"
                android:nextFocusDown="@+id/btnPlayPause"
                android:progressDrawable="@drawable/scrubber_progress_track"
                android:thumb="@drawable/scrubber_thumb"
                android:splitTrack="false" />

            <TextView
                android:id="@+id/tvTimeDuration"
                android:layout_width="wrap_content"
                android:minWidth="54dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#9CA3AF"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:gravity="start" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/buttonsRow"
            android:layout_width="match_parent"
            android:layout_height="44dp">

            <LinearLayout
                android:id="@+id/leftButtonsGroup"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_player_prev"
                    android:background="@drawable/bg_player_btn_mini"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="7dp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusRight="@+id/btnPlayPause"
                    android:contentDescription="Previous Episode" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_player_play"
                    android:background="@drawable/bg_player_btn_mini"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="7dp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnPrev"
                    android:nextFocusRight="@+id/btnNext"
                    android:contentDescription="Play / Pause" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_player_next"
                    android:background="@drawable/bg_player_btn_mini"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="7dp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnPlayPause"
                    android:nextFocusRight="@+id/btnSources"
                    android:contentDescription="Next Episode" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rightButtonsGroup"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnSources"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@drawable/ic_player_sources"
                    android:background="@drawable/bg_player_btn_mini"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="7dp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnNext"
                    android:nextFocusRight="@+id/btnSubtitles"
                    android:contentDescription="Switch Source" />

                <ImageButton
                    android:id="@+id/btnSubtitles"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_player_subs"
                    android:background="@drawable/bg_player_btn_mini"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="7dp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnSources"
                    android:nextFocusRight="@+id/btnAudio"
                    android:contentDescription="Subtitles" />

                <ImageButton
                    android:id="@+id/btnAudio"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_player_audio"
                    android:background="@drawable/bg_player_btn_mini"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="7dp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnSubtitles"
                    android:nextFocusRight="@+id/btnSettings"
                    android:contentDescription="Audio Language" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_player_settings"
                    android:background="@drawable/bg_player_btn_mini"
                    android:focusable="true"
                    android:clickable="true"
                    android:padding="7dp"
                    android:nextFocusUp="@+id/seekBar"
                    android:nextFocusLeft="@+id/btnAudio"
                    android:contentDescription="Settings" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- Slide-Over Right Options Drawer -->
    <LinearLayout
        android:id="@+id/menuOverlay"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F0080A0E"
        android:orientation="vertical"
        android:padding="24dp"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMenuTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Options"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMenuOptions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</FrameLayout>
